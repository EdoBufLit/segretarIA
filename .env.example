# Database Configuration
DATABASE_URL=postgresql://user:password@postgres:5432/app_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# General App Settings
PUBLIC_BASE_URL=https://your-app.onrender.com
DOMAIN_NAME=example.com
SECRET_KEY=change-me-in-production
STUDIO_NAME="Segreteria IA"

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: Price IDs if hardcoded or mapped in env
# STRIPE_PRICE_ID_BASIC=...
# STRIPE_PRICE_ID_PRO=...

# Email / SMTP Configuration
EMAIL_FROM="Segreteria IA <noreply@example.com>"
# EMAIL_TO is often used as a fallback for admin notifications
EMAIL_TO="admin@example.com"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=...

# ElevenLabs & Twilio Integration
ELEVEN_API_KEY=xi_...
# TWILIO_ACCOUNT_SID=... (if used directly, otherwise via ElevenLabs)
# TWILIO_AUTH_TOKEN=...

# Admin Initial Credentials (for seeding)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_password_here
ADMIN_EMAIL=admin@example.com

# Observability
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
